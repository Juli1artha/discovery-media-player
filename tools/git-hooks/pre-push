#!/bin/sh
# Hook pre-push du player. Un seul garde-fou, mais il a déjà coûté une version publiée à vide.
#
# Installation (une fois par clone) :
#   cp tools/git-hooks/pre-push "$(git rev-parse --git-common-dir)/hooks/pre-push"
#   chmod +x "$(git rev-parse --git-common-dir)/hooks/pre-push"
#
# Contournement en connaissance de cause : git push --no-verify

# ══ BRANCHE DÉJÀ MERGÉE = COMMIT ORPHELIN ══════════════════════════════════════════════════
#
# La fusion referme la PR : les commits poussés APRÈS n'atteindront plus jamais main. La branche
# locale, elle, reste ouverte et accepte tout. Le travail est commité, poussé, visible sur
# GitHub — et nulle part.
#
# ⚠️ Arrivé le 14/08/2026 sur ce dépôt : un correctif d'intégration commité quatre minutes après
# la fusion de sa propre PR. La version suivante a été publiée, annoncée à l'hôte qui l'attendait,
# et ne contenait pas le correctif. C'est l'HÔTE qui l'a découvert, en comparant les tarballs npm
# — pas nous. Le dépôt voisin a ce hook depuis le 05/08 pour la même raison ; celui-ci ne l'avait
# pas, et la règle écrite n'a pas suffi : elle demandait de penser à vérifier au bon moment.
BRANCHE=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ -n "$BRANCHE" ] && [ "$BRANCHE" != "HEAD" ] && [ "$BRANCHE" != "main" ] \
   && command -v gh >/dev/null 2>&1; then
  ETAT=$(gh pr view "$BRANCHE" --json state -q .state 2>/dev/null)
  if [ "$ETAT" = "MERGED" ]; then
    echo ""
    echo "✖ pre-push refusé : la PR de « $BRANCHE » est déjà MERGÉE."
    echo "  Ce que tu pousses n'ira PAS dans main."
    echo ""
    echo "  Repars d'un main frais :"
    echo "    git fetch origin main"
    echo "    git checkout -b <nouvelle-branche> origin/main"
    echo "    git cherry-pick <tes commits>"
    echo ""
    echo "  Si tu sais ce que tu fais : git push --no-verify"
    exit 1
  fi
fi

# ══ UN SECRET POUSSÉ NE SE RETIRE PAS ══════════════════════════════════════════════════════
#
# ⚠️ C'EST LE SEUL DÉFAUT DE CE DÉPÔT QU'UN COMMIT NE CORRIGE PAS. Une régression se corrige par
# un correctif ; un secret poussé sur un dépôt PUBLIC est divulgué à la seconde où il arrive.
# Réécrire l'historique n'y change rien — les forges gardent les objets, les miroirs ont déjà
# copié, les moissonneurs indexent en continu. La seule issue est la RÉVOCATION du secret, avec
# tout ce qu'elle coûte. D'où un refus AVANT le push, et pas seulement en CI : la CI le
# constaterait une minute trop tard.
#
# ⚠️ CE QUE CETTE GARDE NE VOIT PAS, ET IL FAUT LE SAVOIR. Elle inspecte les fichiers SUIVIS au
# commit courant, pas l'historique poussé. Un secret commité puis retiré au commit suivant passe
# ici et part quand même dans l'historique. Le contrôle qui rattrape ce cas est la protection de
# poussée de la forge, activée sur le dépôt — celle-ci couvre le cas courant, tôt, hors ligne.
if command -v node >/dev/null 2>&1 && [ -f tools/secrets-en-clair.mjs ]; then
  if ! node tools/secrets-en-clair.mjs >/dev/null; then
    echo ""
    echo "✖ pre-push refusé : un identifiant d'authentification est en clair dans les fichiers suivis."
    echo "  (le détail vient d'être imprimé ci-dessus — fichier, ligne et espèce, jamais la valeur)"
    echo ""
    echo "  Un secret poussé est DIVULGUÉ : le retirer ne suffit pas."
    echo "    1. RÉVOQUE-le chez son émetteur, maintenant ;"
    echo "    2. retire-le de la branche, et remets la variable à valeur vide ;"
    echo "    3. si le code de sortie était 2, la garde n'a rien pu lire — corrige-la, elle."
    echo ""
    echo "  Si tu sais ce que tu fais : git push --no-verify"
    exit 1
  fi
fi

exit 0

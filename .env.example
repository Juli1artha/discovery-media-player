# ── Le minimum : un dossier de documents ───────────────────────────────────────────────────────
# Suffit pour afficher, avec chargement progressif et mesure de lecture. Ni base, ni compte.
PLAYER_LOCAL_ROOT=./documents

# ── Marque ─────────────────────────────────────────────────────────────────────────────────────
# ⚠️ Vides = neutre, et c'est le bon défaut : un player servi pour le compte de quelqu'un d'autre
# ne doit afficher la marque de personne tant qu'on ne le lui a pas demandé.
PLAYER_BRAND_NAME=
PLAYER_BRAND_POWERED_BY=
PLAYER_LOADER_NAME=

# ── Où cette instance se trouve ────────────────────────────────────────────────────────────────
# ⚠️ L'URL PUBLIQUE, telle que VOUS l'écrivez. Sert à fabriquer les liens qui partent par email :
# l'en-tête `Host` ne convient pas, il est choisi par le client — un lecteur pouvait donc faire
# envoyer un message signé de vous dont le bouton pointe ailleurs. Vide ⇒ repli sur `Host`, mais
# signalé dans les journaux. C'est un réglage de sécurité, pas un confort.
PLAYER_PUBLIC_URL=

# ── AGPL ───────────────────────────────────────────────────────────────────────────────────────
# Où un lecteur obtient le source de CETTE instance. Si vous l'avez modifiée, pointez sur la
# vôtre : c'est l'obligation que porte cette licence, et elle vise celui qui expose, pas seulement
# celui qui distribue.
PLAYER_SOURCE_URL=https://github.com/Juli1artha/discovery-media-player
PLAYER_LEGAL_URL=
PLAYER_PRIVACY_URL=
# Texte de la mention de mesure. ⚠️ La seule affichée PAR DÉFAUT : l'absence des autres est un
# choix, l'absence de celle-ci est un risque.
PLAYER_TRACKING_NOTICE=
# ⚠️ Mention d'un lien que PERSONNE n'a envoyé (plaquette publique ouverte depuis une carte).
# Parler d'« expéditeur » y serait faux. Le player choisit d'après le lien : ni destinataire, ni
# créateur. Vide = texte par défaut sans expéditeur.
PLAYER_TRACKING_NOTICE_ANON=

# ── Liens tracés, statistiques, présentation en direct ─────────────────────────────────────────
# Passez d'abord supabase/init.sql sur une base NEUVE.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# ── Documents ailleurs que sur disque ──────────────────────────────────────────────────────────
# Origines de Storage supplémentaires (espaces ou virgules). Seuls les objets PUBLICS passent.
PLAYER_STORAGE_ORIGINS=
# Route de VOTRE application qui sert les fichiers. Préfixe d'URL COMPLET, https, barre finale.
# ⚠️ Un domaine entier rendrait le player capable d'appeler n'importe laquelle de vos routes.
PLAYER_HOST_FETCH_BASE=
# Secret partagé, envoyé en en-tête `x-player-fetch-secret`. Jamais en query : les journaux
# gardent les URL. ≥ 32 caractères, comparaison à temps constant côté hôte.
PLAYER_HOST_FETCH_SECRET=

# ── Qui émet les jetons de vos membres ─────────────────────────────────────────────────────────
# ⚠️ La base du player et votre fournisseur d'identité sont DEUX choses. Le même projet quand le
# player et votre application partagent un déploiement ; différents par construction dès qu'une
# instance est séparée. Vides = repli sur SUPABASE_URL, donc rien ne change pour un déploiement
# partagé. Pointez le PROJET Supabase, pas votre application : l'appel est <URL>/auth/v1/user.
PLAYER_AUTH_URL=
# ⚠️ AUCUN repli, exprès : il allait jusqu'à la clé de service, ce qui reviendrait à remettre la
# clé maîtresse de votre base à un émetteur tiers sur une variable oubliée. Clé PUBLIABLE.
PLAYER_AUTH_KEY=

# ── Décisions qui vous appartiennent ───────────────────────────────────────────────────────────
# Sans elles, le player REFUSE : un droit qu'on ne sait pas accorder ne s'accorde pas.
# ⚠️ S'authentifier n'est pas être autorisé : sans AUTHZ, un membre parfaitement authentifié se
# voit refuser la diffusion, et le refus ressemble à un échec d'authentification.
PLAYER_HOST_AUTHZ_URL=
PLAYER_HOST_BRAND_URL=
# Laisse VOTRE SERVEUR créer un lien tracé en son nom propre — pour un document public que personne
# n'envoie, lu par un visiteur sans compte. ⚠️ DISTINCT de PLAYER_HOST_FETCH_SECRET, exprès :
# celui-ci ne circule qu'en ENTRÉE, l'autre qu'en sortie. Un secret ne suit pas un changement de
# direction. Non configuré ⇒ le chemin n'existe pas.
PLAYER_HOST_SHARE_SECRET=
# Route de VOTRE application qui ENVOIE les emails (re-partage). Sans elle, le player ne prétend
# pas avoir envoyé : il le dit. ⚠️ Un TROISIÈME secret, et c'est un arbitrage : celui des fichiers
# part à chaque document ouvert et vit dans vos journaux ; lui ajouter le pouvoir de faire partir
# du courrier en votre nom élargirait beaucoup ce qu'une fuite de journaux permettrait.
# ⚠️ Le player n'appelle cette route QUE pour un lien qui a un destinataire — un lien anonyme est
# lu par un visiteur quelconque, et vos serveurs deviendraient un relais de courrier.
# ⚠️ Ferme l'écriture des sessions INTERNES à ce que VOTRE serveur a signé. Sans ce réglage, la
# route accepte l'e-mail affirmé par le navigateur — la population interne, celle que le produit
# promet de ne pas mélanger aux prospects, est alors ouverte. Posez-le à `1` une fois votre
# application capable d'émettre le jeton (cf. docs/API.md). Fermé par défaut casserait l'existant.
# ⚠️ Combien de proxys de CONFIANCE devant cette instance. Vide = l'en-tête `X-Forwarded-For` est
# ignoré, et l'appelant est identifié par sa socket — c'est le bon défaut : cet en-tête est une
# affirmation du client, et toutes les limites de débit en dépendent. Avec `1`, on lit la dernière
# valeur ajoutée (celle du proxy), pas la première (celle que le client a écrite).
PLAYER_TRUSTED_PROXY_HOPS=

PLAYER_INTERNAL_STRICT=

PLAYER_HOST_MAIL_URL=
PLAYER_HOST_MAIL_SECRET=
# Logo de l'instance (URL). Vide = aucun, cf. la section Marque.
PLAYER_BRAND_LOGO=

# ── Divers ─────────────────────────────────────────────────────────────────────────────────────
PLAYER_PLUGINS_OFF=
DOC_FRAME_ANCESTORS=
GOOGLE_MAPS_API_KEY=
PORT=3000
HOST=0.0.0.0

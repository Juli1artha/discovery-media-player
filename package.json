{
  "name": "discovery-media-player",
  "version": "0.1.38",
  "description": "Self-hosted document viewer: per-recipient tracked links, reading analytics, live presentation. The core knows nothing about the application hosting it — everything it borrows arrives through an injected context.",
  "keywords": [
    "pdf-viewer",
    "document-tracking",
    "read-receipts",
    "document-analytics",
    "live-presentation",
    "self-hosted",
    "pdfjs",
    "sales-enablement"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "3D Discovery",
  "homepage": "https://github.com/Juli1artha/discovery-media-player#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juli1artha/discovery-media-player.git"
  },
  "bugs": {
    "url": "https://github.com/Juli1artha/discovery-media-player/issues"
  },
  "main": "server/handler.js",
  "bin": {
    "discovery-media-player": "bin/serve.js"
  },
  "files": [
    "bin",
    "context",
    "dist",
    "server",
    "supabase",
    "README.md",
    "LICENSE",
    "LICENSE-MIT",
    "docs/HOST-CONTRACT.md",
    "!**/__tests__"
  ],
  "exports": {
    ".": "./server/handler.js",
    "./shares": "./server/shares.js",
    "./presentations": "./server/presentations.js",
    "./brands": "./server/brands.js",
    "./context/standalone": "./context/standalone.js",
    "./context/storage": "./context/storage.js",
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "default": "./dist/bridge.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "node tools/install-hooks.mjs",
    "start": "node bin/serve.js",
    "build": "node build/bundle.mjs && tsc -p tsconfig.build.json && node -e \"import('./build/bundle.mjs').then(m=>m.marquerDistEsm())\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint bin context server src build",
    "lint:fix": "eslint bin context server src build --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.10"
  }
}
